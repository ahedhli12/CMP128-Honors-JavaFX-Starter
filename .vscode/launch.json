{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "java",
      "name": "Run Honors JavaFX",
      "request": "launch",
      "mainClass": "HonorsLauncher",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "vmArgs": "--module-path \"${input:javafxLibPath}\" --add-modules javafx.controls"
    }
  ],
  "inputs": [
    {
      "id": "javafxLibPath",
      "type": "promptString",
      "description": "Paste your extracted JavaFX SDK lib folder path, without quotes. It must contain javafx.controls.jar."
    }
  ]
}
