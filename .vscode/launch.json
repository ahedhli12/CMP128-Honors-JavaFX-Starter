{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "java",
      "name": "Run Honors JavaFX",
      "request": "launch",
      "mainClass": "HonorsLauncher",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "vmArgs": "--module-path \"C:/REPLACE-WITH-YOUR-JAVAFX-SDK/lib\" --add-modules javafx.controls"
    }
  ]
}
